{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    /* Die CI-Lane lädt src/domain über Nodes Typ-Stripping (GSPP-251):
       nicht löschbare TS-Syntax würde sie brechen. */
    "erasableSyntaxOnly": true,

    /* Paths */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  /*
   * Node-Tests (`*.node.test.ts`) laufen bewusst außerhalb des Browser-
   * Typraums: Sie brauchen `node:fs`/`node:v8`, die App-Quellen ausdrücklich
   * nicht. Sie werden von tsconfig.node.json geprüft.
   */
  "exclude": ["src/**/*.node.test.ts"]
}
