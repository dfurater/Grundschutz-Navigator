{
  "name": "grundschutz-navigator",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:local": "BUILD_BASE=/ npm run build",
    "preview": "vite preview",
    "preview:local": "npm run build:local && vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:browser:egress-negative": "node scripts/verify-browser-egress.mjs",
    "lint": "eslint .",
    "fetch-catalog": "node scripts/fetch-catalog.mjs",
    "verify-upstream-oscal": "node scripts/verify-upstream-oscal.mjs",
    "verify-oscal-schemas": "node scripts/verify-oscal-schemas.mjs",
    "sync-oscal-schemas": "node scripts/sync-oscal-schemas.mjs --write"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "flexsearch": "^0.8.212",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.7",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "playwright": "1.62.1",
    "tailwindcss": "^4.1.7",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.16",
    "vitest": "4.1.10"
  }
}
